{
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch",
      "color",
      "color-mix"
    ],
    "declaration-property-value-allowed-list": {
      "font-family": ["/^var\\(--[\\w-]+\\)$/", "inherit", "/^[\"']Barlow( Condensed)?[\"']$/"],
      "box-shadow": ["/^var\\(--[\\w-]+\\)$/", "none", "inherit"],
      "text-shadow": ["/^var\\(--[\\w-]+\\)$/", "none", "inherit"]
    }
  },
  "overrides": [
    {
      "files": ["src/estilos/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-allowed-list": null
      }
    }
  ]
}
