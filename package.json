{
  "name": "gestaodapelada-v2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test && vitest run",
    "migrar": "pnpm --filter @pelada/scripts migrar",
    "esquema:gerar": "pnpm --filter @pelada/scripts esquema:gerar"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
