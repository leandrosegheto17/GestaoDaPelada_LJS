{
  "name": "gestao-da-pelada",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "lint": "pnpm -r lint && eslint .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "migrar": "pnpm --filter @pelada/scripts migrar",
    "esquema:gerar": "pnpm --filter @pelada/scripts esquema:gerar",
    "esquema:comparar": "pnpm --filter @pelada/scripts esquema:comparar",
    "test:checagens": "pnpm --filter @pelada/scripts test:checagens",
    "migracao:nova": "pnpm --filter @pelada/scripts migracao:nova",
    "seed": "pnpm --filter @pelada/scripts seed",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0"
  }
}
