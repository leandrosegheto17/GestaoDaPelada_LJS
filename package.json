{
  "name": "gestao-da-pelada",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "lint": "eslint test eslint.config.mjs && pnpm -r lint",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p .",
    "test": "vitest run --dir test && pnpm -r test",
    "restaurar": "node --env-file-if-exists=.env backend/scripts/ops/restaurar-backup.ts",
    "migrar": "node --env-file-if-exists=.env backend/scripts/src/migrar.ts",
    "seed": "node --env-file-if-exists=.env backend/scripts/src/seed.ts",
    "esquema:gerar": "node --env-file-if-exists=.env backend/scripts/src/esquema-gerar.ts",
    "test:checagens": "pnpm --filter @pelada/scripts exec vitest run checagens",
    "migracao:nova": "node backend/scripts/src/migracao-nova.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
