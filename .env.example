# Nomes das variáveis; nenhum valor real. Copie para .env (ignorado pelo git).
# Cada variável traz, na linha de comentário logo acima, "obrigatória", "formato" e "segredo" (checagem FUN-46).
# Segredo nunca tem valor aqui: preencha só no seu .env, nos secrets do GitHub ou no ambiente do Cloudflare.

# obrigatória: não | formato: URL postgres (padrão: o banco local do docker compose) | segredo: não
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pelada
# obrigatória: não | formato: URL postgres do cluster de testes (padrão: o banco local) | segredo: não
DATABASE_URL_TESTE=postgres://postgres:postgres@127.0.0.1:5432/pelada
# obrigatória: sim, em pnpm migrar e pnpm seed | formato: URL postgres da role de migração, host local | segredo: não
DATABASE_URL_MIGRACAO=postgres://postgres:postgres@127.0.0.1:5432/pelada
# obrigatória: sim, em pnpm seed e pnpm dev | formato: texto, senha da role pelada_app | segredo: sim
PELADA_APP_SENHA=
# obrigatória: sim, em pnpm seed | formato: texto, senha da role pelada_backup_ro | segredo: sim
PELADA_BACKUP_RO_SENHA=

# obrigatória: não | formato: porta TCP (padrão 5432) do Postgres local usado pelo pnpm dev | segredo: não
PELADA_DEV_BANCO_PORTA=
# obrigatória: não | formato: porta TCP (padrão 8787) do wrangler dev no pnpm dev | segredo: não
PELADA_DEV_PORTA_API=
# obrigatória: não | formato: porta TCP (padrão 5173) do Vite no pnpm dev | segredo: não
PELADA_DEV_PORTA_WEB=

# obrigatória: não | formato: 1 para incluir as rotas de vitrine no build (só a comparação visual usa) | segredo: não
VITE_VITRINE=
# obrigatória: não | formato: URL do projeto no Sentry do front; vazio desliga o Sentry | segredo: sim
VITE_SENTRY_DSN=
# obrigatória: não | formato: SHA do commit publicado (release do Sentry do front) | segredo: não
VITE_VERSAO=

# obrigatória: não | formato: URL do projeto no Sentry do Worker; vazio desliga o Sentry (secret do Worker) | segredo: sim
SENTRY_DSN=
# obrigatória: sim, no deploy | formato: SHA do commit publicado, injetado por --var | segredo: não
VERSAO=
# obrigatória: sim, no deploy | formato: URL https do app, injetada por --var (nunca escrita no código, FUN-23) | segredo: não
URL_PUBLICA=

# obrigatória: sim, no workflow backup.yml | formato: URL postgres da role somente leitura do Neon (secret do GitHub) | segredo: sim
NEON_URL_BACKUP=
# obrigatória: sim, no workflow backup.yml | formato: chave pública age (secret do GitHub) | segredo: sim
BACKUP_CHAVE=

# obrigatória: não | formato: texto; a suíte do Worker gera uma senha aleatória quando vazio | segredo: sim
WORKER_TESTE_SENHA=
