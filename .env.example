# Nomes das variáveis; nenhum valor real. Copie para .env (ignorado pelo git).
# Cada variável traz, na linha de comentário logo acima, "obrigatória", "formato" e "segredo" (checagem FUN-46).
# Segredo nunca tem valor aqui: preencha só no seu .env, nos secrets do GitHub ou no ambiente do Cloudflare.

# obrigatória: não | formato: URL postgres (padrão: o banco local do docker compose) | segredo: não
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pelada
# obrigatória: não | formato: URL postgres do cluster de testes (padrão: o banco local) | segredo: não
DATABASE_URL_TESTE=postgres://postgres:postgres@127.0.0.1:5432/pelada
# obrigatória: sim, em pnpm migrar e pnpm seed | formato: URL postgres da role de migração, host local | segredo: não
DATABASE_URL_MIGRACAO=postgres://postgres:postgres@127.0.0.1:5432/pelada
# obrigatória: sim, em pnpm seed e pnpm dev | formato: texto, senha da role pelada_app | segredo: sim
PELADA_APP_SENHA=
# obrigatória: sim, em pnpm seed | formato: texto, senha da role pelada_backup_ro | segredo: sim
PELADA_BACKUP_RO_SENHA=

# obrigatória: não | formato: porta TCP (padrão 5432) do Postgres local usado pelo pnpm dev | segredo: não
PELADA_DEV_BANCO_PORTA=
# obrigatória: não | formato: porta TCP (padrão 8787) do wrangler dev no pnpm dev | segredo: não
PELADA_DEV_PORTA_API=
# obrigatória: não | formato: porta TCP (padrão 5173) do Vite no pnpm dev | segredo: não
PELADA_DEV_PORTA_WEB=
# obrigatória: não | formato: porta TCP (padrão 4174) do vite preview da comparação visual (pnpm visual) | segredo: não
PELADA_VISUAL_PORTA=
# obrigatória: não | formato: expressão regular sobre o nome da comparação visual, ex. ^t20- (pnpm visual) | segredo: não
PELADA_VISUAL_FILTRO=
# obrigatória: não | formato: milissegundos de espera por tela na comparação visual (pnpm visual) | segredo: não
PELADA_VISUAL_TIMEOUT=

# obrigatória: não | formato: 1 para incluir as rotas de vitrine no build (só a comparação visual usa) | segredo: não
VITE_VITRINE=
# obrigatória: não | formato: URL do projeto no Sentry do front; vazio desliga o Sentry | segredo: sim
VITE_SENTRY_DSN=
# obrigatória: não | formato: SHA do commit publicado (release do Sentry do front) | segredo: não
VITE_VERSAO=

# obrigatória: não | formato: URL do projeto no Sentry do Worker; vazio desliga o Sentry (secret do Worker) | segredo: sim
SENTRY_DSN=
# obrigatória: sim, no deploy | formato: SHA do commit publicado, injetado por --var | segredo: não
VERSAO=
# obrigatória: sim, no deploy | formato: URL https do app, injetada por --var (nunca escrita no código, FUN-23) | segredo: não
URL_PUBLICA=

# obrigatória: sim, no deploy (secret do Worker no environment previa) | formato: chave da API do Resend, começa por re_ | segredo: sim
RESEND_API_KEY=
# obrigatória: sim, no deploy | formato: remetente dos e-mails de conta, ex. Pelada <nao-responda@dominio-verificado> | segredo: não
RESEND_REMETENTE=
# obrigatória: não | formato: inteiro, teto diário de e-mails de conta (padrão 100, o do Resend Free) | segredo: não
LIMITE_EMAILS_DIA=
# obrigatória: não | formato: 1 liga a caixa de e-mails em memória e GET /api/dev/emails (só .env local e e2e; nunca no wrangler.jsonc) | segredo: não
EMAIL_DEV=
# obrigatória: sim, em pnpm seed | formato: texto, senha da conta admin de teste criada pelo seed (8 a 72 caracteres) | segredo: sim
SEED_SENHA_ADMIN=

# obrigatória: não (opcional: sem as três VAPID o push fica desligado e o e-mail continua) | formato: chave pública P-256 não comprimida, 65 bytes em base64url (gere com pnpm vapid:gerar) | segredo: não
VAPID_PUBLICA=
# obrigatória: não (opcional: sem as três VAPID o push fica desligado) | formato: chave privada P-256 (d), 32 bytes em base64url, par da VAPID_PUBLICA (secret do Worker) | segredo: sim
VAPID_PRIVADA=
# obrigatória: não (opcional: sem as três VAPID o push fica desligado) | formato: contato do remetente dos avisos, mailto:endereco ou URL https | segredo: não
VAPID_ASSUNTO=
# obrigatória: não | formato: hosts do serviço de push falso separados por vírgula, só localhost ou *.localhost com porta (ex.: localhost:8790); só .env local e e2e, nunca no wrangler.jsonc nem no deploy | segredo: não
PUSH_HOSTS_DEV=

# obrigatória: sim, em pnpm esquema:comparar --alvo dev | formato: URL postgres da role dona da branch dev do Neon (só no seu .env, junto com PELADA_PERMITIR_HOST_REMOTO=1) | segredo: sim
NEON_URL_DEV_MIGRACAO=
# obrigatória: sim, em migração ou comparação contra host remoto | formato: 1 confirma o host remoto (o deploy.yml também define) | segredo: não
PELADA_PERMITIR_HOST_REMOTO=

# obrigatória: não | formato: URL postgres do banco local vazio onde o pnpm restaurar grava o backup, quando o terceiro argumento falta | segredo: não
DATABASE_URL_RESTAURACAO=

# obrigatória: sim, no workflow backup.yml | formato: URL postgres da role somente leitura do Neon (secret do GitHub) | segredo: sim
NEON_URL_BACKUP=
# obrigatória: sim, no workflow backup.yml | formato: chave pública age (secret do GitHub) | segredo: sim
BACKUP_CHAVE=

# obrigatória: não | formato: texto; a suíte do Worker gera uma senha aleatória quando vazio | segredo: sim
WORKER_TESTE_SENHA=

# obrigatória: sim, no deploy.yml | formato: URL postgres da role pelada_owner da main do Neon (secret do environment producao) | segredo: sim
NEON_URL_MIGRACAO=
# obrigatória: sim, no deploy.yml | formato: chave da API do Neon com o menor escopo possível (secret do environment producao) | segredo: sim
NEON_API_KEY=
# obrigatória: sim, no deploy.yml | formato: identificador do projeto no Neon, ex. proj-abc-123 (secret do environment producao) | segredo: sim
NEON_PROJECT_ID=
# obrigatória: sim, no deploy.yml | formato: token da API da Cloudflare só com permissão de Workers (secret do environment producao) | segredo: sim
CLOUDFLARE_API_TOKEN=
# obrigatória: sim, no deploy.yml | formato: ID da conta Cloudflare, 32 caracteres hexadecimais (secret do environment producao) | segredo: sim
CLOUDFLARE_ACCOUNT_ID=

# obrigatória: não | formato: número de tentativas da verificação de saúde pós-deploy (padrão 10) | segredo: não
PELADA_SAUDE_TENTATIVAS=
# obrigatória: não | formato: milissegundos entre as tentativas da verificação de saúde (padrão 3000) | segredo: não
PELADA_SAUDE_ESPERA_MS=

# obrigatória: sim, em pnpm --filter @pelada/scripts medir-simulador disparar | formato: token da sessão de uma admin do grupo de teste na prévia, copiado do cookie __Host-sessao (só no seu ambiente, na hora da medição) | segredo: sim
SESSAO_MEDICAO=

# obrigatória: sim, no deploy (secret do Worker no environment producao) | formato: chave da API do Asaas sandbox, começa pelo prefixo do Asaas | segredo: sim
ASAAS_API_KEY=
# obrigatória: sim, no deploy (secret do Worker no environment producao) | formato: texto de 32 a 255 caracteres, o authToken do webhook no Asaas, diferente da chave | segredo: sim
ASAAS_WEBHOOK_TOKEN=
# obrigatória: não (padrão: o sandbox do wrangler.jsonc) | formato: URL base da API do Asaas; só https://api-sandbox.asaas.com/v3 até haver AD de produção (PLA-38) | segredo: não
ASAAS_URL=https://api-sandbox.asaas.com/v3
# obrigatória: não | formato: porta TCP (padrão 8788) do wrangler dev do e2e (pnpm --filter @pelada/web e2e); mude para rodar dois e2e na mesma máquina | segredo: não
PELADA_E2E_PORTA_API=
# obrigatória: não | formato: porta TCP (padrão 8789) do Asaas falso do e2e | segredo: não
ASAAS_FALSO_PORTA=
# obrigatória: não | formato: URL do webhook do Worker que o Asaas falso do e2e chama | segredo: não
ASAAS_FALSO_WEBHOOK=
# obrigatória: não | formato: token falso do webhook, só do e2e (o mesmo de ASAAS_WEBHOOK_TOKEN no wrangler dev do e2e) | segredo: não
ASAAS_FALSO_TOKEN=

# obrigatória: não | formato: URL postgres que o pool do Worker nos testes do api (vitest) usa no lugar do Hyperdrive (padrão: montada com PELADA_APP_SENHA) | segredo: sim
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
# obrigatória: não | formato: porta TCP (padrão 8790) do servidor de push falso do e2e | segredo: não
PUSH_FALSO_PORTA=
# obrigatória: não | formato: chave VAPID pública do e2e (padrão: o par é gerado na hora, só para o teste) | segredo: não
PELADA_E2E_VAPID_PUBLICA=
# obrigatória: não | formato: chave VAPID privada do e2e (padrão: o par é gerado na hora, só para o teste) | segredo: sim
PELADA_E2E_VAPID_PRIVADA=
