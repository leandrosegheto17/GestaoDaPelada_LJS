# Variáveis de ambiente do projeto. Copie para `.env` (ignorado pelo git) e preencha o que o seu uso pede.
# Cada variável traz: obrigatoriedade, formato e se é segredo. Segredo nunca é versionado: aqui tudo fica sem valor.
# Um teste (backend/scripts/test/env-example.test.ts) falha se uma variável usada no código, no wrangler.jsonc ou
# nos workflows não estiver listada aqui.
#
# Onde cada grupo vale:
#   [local]    arquivo `.env` da raiz, lido por `pnpm dev`, `pnpm migrar`, `pnpm seed` e pelos testes.
#   [worker]   segredo ou variável do Worker (`wrangler secret put` / `--var`); nunca no wrangler.jsonc.
#   [build]    variável de build do web (Vite), embutida no bundle: nunca coloque segredo aqui.
#   [github]   secret ou variável do environment `producao` ou `backup`, nunca do nível do repositório (runbook em
#              docs/runbook.md, seção 2).
#   [teste]    ajuste opcional de e2e e comparação visual.

# ---------------------------------------------------------------- [local] banco e roles

# Obrigatória: sim (local) | Formato: URL postgres://usuario:senha@host:porta/banco; local = o banco do docker-compose | Segredo: sim
DATABASE_URL=

# Obrigatória: só para rodar os testes da API | Formato: URL postgres://..., num banco descartável (host local) | Segredo: sim
DATABASE_URL_TESTE=

# Obrigatória: sim (local) | Formato: texto sem espaços, 24+ caracteres; o `pnpm seed` dá esta senha à role pelada_app | Segredo: sim
PELADA_APP_SENHA=

# Obrigatória: só para o seed e a restauração local | Formato: texto sem espaços, 24+ caracteres; senha da role pelada_backup | Segredo: sim
PELADA_BACKUP_SENHA=

# Obrigatória: não (o `pnpm dev` monta esta a partir de DATABASE_URL e PELADA_APP_SENHA) | Formato: URL postgres://pelada_app:senha@host:porta/banco | Segredo: sim
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Obrigatória: não (o `pnpm dev` define como false, para o Worker local receber só o que o wrangler.jsonc declara) | Formato: true ou false | Segredo: não
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=

# ---------------------------------------------------------------- [worker] e [build] observabilidade e endereço

# Obrigatória: sim em produção (injetada pelo deploy com --var; o wrangler.jsonc traz o valor local) | Formato: origem https sem barra final, ex.: https://host | Segredo: não
URL_PUBLICA=

# Obrigatória: sim em produção (injetada pelo deploy com --var VERSAO:<sha>; o wrangler.jsonc traz `dev` para o local) | Formato: SHA do commit publicado; `/api/health` devolve este valor | Segredo: não
VERSAO=

# Obrigatória: não (sem ela o Sentry do Worker fica desligado) | Formato: URL do DSN do Sentry (https://chave@host/id) | Segredo: sim
SENTRY_DSN=

# Obrigatória: não (sem ela o Sentry do front fica desligado) | Formato: URL do DSN do Sentry; vai para o bundle público | Segredo: não (público por natureza)
VITE_SENTRY_DSN=

# Obrigatória: não (o deploy e o CI passam o SHA) | Formato: SHA do commit, 40 caracteres hexadecimais; vira o `release` do Sentry no front | Segredo: não
VITE_VERSAO=

# Obrigatória: não | Formato: lista de recursos separados por vírgula, a desligar no front | Segredo: não
VITE_RECURSOS_DESLIGADOS=

# Obrigatória: não (build de teste: o e2e e a comparação visual ligam a vitrine) | Formato: 1 ou vazio | Segredo: não
VITE_VITRINE=

# ---------------------------------------------------------------- [github] deploy e backup (secrets e variáveis)

# Obrigatória: sim para o deploy | Formato: URL postgres://... da role owner (migração) no Neon, conexão direta | Segredo: sim
NEON_URL_MIGRACAO=

# Obrigatória: sim para o backup | Formato: URL postgres://... da role pelada_backup (somente leitura) no Neon, conexão direta | Segredo: sim
NEON_URL_BACKUP=

# Obrigatória: sim para o deploy | Formato: chave de API do Neon, só [A-Za-z0-9_-] | Segredo: sim
NEON_API_KEY=

# Obrigatória: sim para o deploy | Formato: id do projeto Neon | Segredo: não
NEON_PROJECT_ID=

# Obrigatória: sim para o backup e o dump do deploy | Formato: destinatário público age, começa com age1 (a chave privada fica fora do GitHub) | Segredo: não (é a chave pública)
BACKUP_CHAVE=

# Obrigatória: sim para o deploy | Formato: token da API da Cloudflare, só [A-Za-z0-9_-], com permissão para Workers e Hyperdrive | Segredo: sim
CLOUDFLARE_API_TOKEN=

# Obrigatória: sim para o deploy | Formato: id da conta Cloudflare, 32 hexadecimais | Segredo: não
CLOUDFLARE_ACCOUNT_ID=

# Obrigatória: sim para o deploy (o workflow já fixa o valor) | Formato: https://api.cloudflare.com/client/v4 | Segredo: não
CLOUDFLARE_API_BASE=

# ---------------------------------------------------------------- [teste] e2e e comparação visual

# Obrigatória: não | Formato: porta numérica; padrão 4183 | Segredo: não
VISUAL_PORTA=

# Obrigatória: não | Formato: caminho de pasta com o build para a comparação visual | Segredo: não
DIST_VISUAL=

# Obrigatória: não | Formato: caminho do arquivo com a lista de telas ativas | Segredo: não
TELAS_ATIVAS_ARQUIVO=

# Obrigatória: não | Formato: 1 para não refazer o build antes da comparação | Segredo: não
VISUAL_SEM_BUILD=

# ---------------------------------------------------------------- nomes reservados das features futuras (sem uso na fundação)

# Obrigatória: só na feature `notificacoes` | Formato: chave de API do Resend (re_...) | Segredo: sim
RESEND_API_KEY=

# Obrigatória: só na feature `notificacoes` | Formato: endereço de remetente verificado no Resend | Segredo: não
RESEND_REMETENTE=

# Obrigatória: só na feature `notificacoes` | Formato: chave pública VAPID em base64url | Segredo: não
VAPID_PUBLIC_KEY=

# Obrigatória: só na feature `notificacoes` | Formato: chave privada VAPID em base64url | Segredo: sim
VAPID_PRIVATE_KEY=

# Obrigatória: só na feature `notificacoes` | Formato: mailto:contato@dominio ou URL https | Segredo: não
VAPID_ASSUNTO=
