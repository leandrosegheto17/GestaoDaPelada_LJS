# Variáveis do ambiente local. Copie para .env e ajuste. Nunca ponha valores de produção aqui.
# Banco local do docker-compose (superusuário postgres, AD-009).
DATABASE_URL=postgres://pelada_app:troque-esta-senha@127.0.0.1:5432/pelada
DATABASE_URL_TESTE=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL_MIGRACAO=postgres://postgres:postgres@127.0.0.1:5432/pelada
# Senhas definidas pelo seed para as roles pelada_app e pelada_backup_ro.
PELADA_APP_SENHA=troque-esta-senha
PELADA_BACKUP_RO_SENHA=troque-esta-senha
