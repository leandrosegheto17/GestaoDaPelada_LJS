{
  // Prévia da v2: Worker único com os arquivos estáticos do app e a API em /api/* no mesmo host (FUN-20, FUN-27).
  "name": "gestaodapelada-v2",
  "main": "backend/api/src/entrada/worker.ts",
  // Data máxima aceita pelo workerd do @cloudflare/vitest-plugin.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // Só workers.dev: sem routes e sem domínio próprio até a paridade (AD-004).
  "workers_dev": true,
  "assets": {
    "directory": "frontend/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // O id real do Hyperdrive entra na T79. O cache fica desligado (`--caching-disabled`, FUN-18) na config do
  // Hyperdrive, não neste arquivo. A senha local nunca fica aqui: o `pnpm dev` injeta a string completa.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e06363bd85874f1eaffc6382da6d394b",
      "localConnectionString": "postgres://pelada_app@127.0.0.1:5432/pelada",
    },
  ],
  // FUN-26. O período só aceita 10 ou 60 segundos.
  "ratelimits": [
    { "name": "LIMITE_ENTRAR", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_PUBLICO", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_WEBHOOK", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_ESCRITA", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
  ],
  // O deploy injeta os valores reais por `--var`.
  "vars": {
    "URL_PUBLICA": "http://localhost:8787",
    "VERSAO": "dev",
  },
}
