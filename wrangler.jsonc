// Worker da prévia (FUN-20, FUN-26, FUN-27; AD-004, AD-119, AD-121): o único alvo publicado é o
// gestaodapelada-v2, no endereço padrão da Cloudflare e no único domínio próprio da AD-121
// (a linha da rota abaixo). Qualquer outra rota ou domínio reprova na checagem so-previa.
// O deploy só acontece pelo .github/workflows/deploy.yml (FUN-45).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestaodapelada-v2",
  "main": "backend/api/src/entrada/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "gestaodapelada.ljssoftware.com.br", "custom_domain": true }],

  // O build do front é servido como SPA; só /api/* passa pelo Worker (Hono) antes dos assets.
  "assets": {
    "directory": "frontend/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Limites por minuto (FUN-26). O namespace_id é só um número único por binding na conta.
  "ratelimits": [
    { "name": "LIMITE_ENTRAR", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_PUBLICO", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_WEBHOOK", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_ESCRITA", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } }
  ],

  // Hyperdrive da prévia, sobre a main do Neon (AD-119), com cache desligado (FUN-18).
  // Id do Hyperdrive existente (AD-032, AD-119; T79). Local: o wrangler dev usa o localConnectionString,
  // sem senha aqui; o pnpm dev passa a URL com a senha do .env por
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e06363bd85874f1eaffc6382da6d394b",
      "localConnectionString": "postgres://pelada_app@127.0.0.1:5432/pelada"
    }
  ],

  // Fila dos avisos (notificacoes T16; NOT-22, AD-098): a rota só enfileira depois do COMMIT e o mesmo Worker consome,
  // uma mensagem por invocação (NOT-34) e até 2 novas entregas de uma invocação que falhou. A fila `avisos` é criada
  // pelo usuário no /preparar Nível 2 (`wrangler queues create avisos`).
  "queues": {
    "producers": [{ "binding": "FILA_AVISOS", "queue": "avisos" }],
    "consumers": [{ "queue": "avisos", "max_batch_size": 1, "max_retries": 2 }]
  },

  // Limpeza diária das notificações às 06:00 UTC (notificacoes T26; NOT-56, NOT-57). O plano Free aceita até 5 Crons.
  "triggers": { "crons": ["0 6 * * *"] },

  // Valores locais. No deploy, VERSAO (SHA do commit) e URL_PUBLICA chegam por --var (FUN-23, FUN-58).
  // ASAAS_URL: só o sandbox até haver AD de produção (PLA-38, checagem so-previa); a chave e o token do webhook
  // são secrets do Worker (ASAAS_API_KEY, ASAAS_WEBHOOK_TOKEN), nunca aqui.
  "vars": {
    "VERSAO": "local",
    "URL_PUBLICA": "",
    "ASAAS_URL": "https://api-sandbox.asaas.com/v3"
  }
}
